{
  "name": "vaish-erp",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm --workspace=apps/client run dev",
    "dev:server": "npm --workspace=apps/server run dev",
    "build": "cd apps/client && npm install && npm run build",
    "start": "npm --workspace=apps/server run start"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0"
  }
}