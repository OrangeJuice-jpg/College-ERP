{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "cd apps/client && npm install && npm run build",
  "outputDirectory": "apps/client/dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.ts" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
